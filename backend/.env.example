# Copiar a backend/.env y completar con valores reales. backend/.env NO se commitea
# (ya esta cubierto por backend/.gitignore).

PORT=3000

# Conexion a MySQL usada por backend/src/config/database.js (mysql2 createPool).
# DB_HOST=mysql corresponde al nombre del servicio en docker-compose.yml.
# Para desarrollo LOCAL sin Docker, usar DB_HOST=localhost.
DB_HOST=mysql
DB_PORT=3306
DB_USER=trendy_user
DB_PASSWORD=changeme
DB_NAME=trendy
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                   Int                   @id @default(autoincrement())
  nombre               String
  correo               String                @unique
  passwordHash         String
  rolId                Int
  estado               EstadoUsuario         @default(ACTIVO)
  creadoEn             DateTime              @default(now())
  rol                  Rol                   @relation(fields: [rolId], references: [id])
  direcciones          Direccion[]
  passwordResetTokens  PasswordResetToken[]
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
  permisos Permiso[]
}

// Nota: relación N-N Rol-Permiso es una decisión de este PR, no viene explícita en el DDS — confirmar con el equipo si prefieren un modelo distinto
model Permiso {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  roles  Rol[]
}

model Direccion {
  id           Int     @id @default(autoincrement())
  usuarioId    Int
  destinatario String
  telefono     String
  calle        String
  ciudad       String
  departamento String
  codigoPostal String?
  referencia   String?
  esPrincipal  Boolean @default(false)
  usuario      Usuario @relation(fields: [usuarioId], references: [id])
}

// RF-003 (recuperación de contraseña): token de un solo uso con vencimiento.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  token     String   @unique
  expiraEn  DateTime
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

// Sprint 2 / Ronda 1 (MOD-02, RF-008 a RF-011): estos 4 modelos (Categoria,
// Producto, Variante, Imagen) NO existían todavía en el schema al empezar
// esta ronda — se agregan acá porque backend/src/repositories/producto.repository.js
// (escrito por una compañera de equipo en un commit previo de sprint-2) ya
// asume su forma (categoriaId, variantes.stock/talla, imagenes, precio,
// estado) pero el modelo Prisma nunca se había definido. Campos elegidos
// como razonables para el MVP; a confirmar con el equipo si el DDS define
// algo más específico.
enum EstadoCatalogo {
  ACTIVO
  INACTIVO
}

// ERS §2.8.3: gestión dinámica de categorías es v2.0, fuera de alcance del
// MVP. Acá solo se listan las activas (semilla directa en la base, ver
// prisma/seed.js) — no hay create/update/delete de categorías en esta ronda.
model Categoria {
  id        Int            @id @default(autoincrement())
  nombre    String         @unique
  estado    EstadoCatalogo @default(ACTIVO)
  productos Producto[]
}

model Producto {
  id          Int            @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Decimal        @db.Decimal(10, 2)
  estado      EstadoCatalogo @default(ACTIVO)
  categoriaId Int
  creadoEn    DateTime       @default(now())
  categoria   Categoria      @relation(fields: [categoriaId], references: [id])
  variantes   Variante[]
  imagenes    Imagen[]
}

// RN-001 (ver producto.repository.js): un producto solo se considera
// disponible si tiene al menos una variante con stock > 0. `talla` es
// String libre (S/M/L/XL/numérica) en vez de enum porque el DDS no fija un
// set cerrado de tallas por categoría (ropa vs. calzado, por ejemplo).
model Variante {
  id         Int      @id @default(autoincrement())
  productoId Int
  talla      String
  stock      Int      @default(0)
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([productoId, talla])
}

model Imagen {
  id         Int      @id @default(autoincrement())
  productoId Int
  url        String
  orden      Int      @default(0)
  producto   Producto @relation(fields: [productoId], references: [id])
}

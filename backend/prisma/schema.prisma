// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                   Int                   @id @default(autoincrement())
  nombre               String
  correo               String                @unique
  passwordHash         String
  rolId                Int
  estado               EstadoUsuario         @default(ACTIVO)
  creadoEn             DateTime              @default(now())
  rol                  Rol                   @relation(fields: [rolId], references: [id])
  direcciones          Direccion[]
  passwordResetTokens  PasswordResetToken[]
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
  permisos Permiso[]
}

// Nota: relación N-N Rol-Permiso es una decisión de este PR, no viene explícita en el DDS — confirmar con el equipo si prefieren un modelo distinto
model Permiso {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  roles  Rol[]
}

model Direccion {
  id           Int     @id @default(autoincrement())
  usuarioId    Int
  destinatario String
  telefono     String
  calle        String
  ciudad       String
  departamento String
  codigoPostal String?
  referencia   String?
  esPrincipal  Boolean @default(false)
  usuario      Usuario @relation(fields: [usuarioId], references: [id])
}

// RF-003 (recuperación de contraseña): token de un solo uso con vencimiento.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  token     String   @unique
  expiraEn  DateTime
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

// Sprint 2 / Ronda 1 (MOD-02, RF-008 a RF-011): estos 4 modelos (Categoria,
// Producto, Variante, Imagen) NO existían todavía en el schema al empezar
// esta ronda. Producto y Variante siguen el fragmento EXACTO del DDS §4.2
// (verificado contra el docx original, no inventado) — el primer intento de
// esta ronda se había desviado (le faltaba sku/color en Variante, entre
// otras cosas) y se corrigió antes de mergear. Categoria e Imagen no tienen
// fragmento en el DDS, son campos razonables propuestos para el MVP.
enum EstadoProducto {
  ACTIVO
  INACTIVO
}

// ERS §2.8.3: gestión dinámica de categorías es v2.0, fuera de alcance del
// MVP. Acá solo se listan las activas (semilla directa en la base, ver
// prisma/seed.js) — no hay create/update/delete de categorías en esta ronda.
model Categoria {
  id        Int            @id @default(autoincrement())
  nombre    String         @unique
  estado    EstadoProducto @default(ACTIVO)
  productos Producto[]
}

// DDS §4.2 — fragmento textual, sin modificar.
model Producto {
  id          Int            @id @default(autoincrement())
  nombre      String
  descripcion String         @db.Text
  precio      Decimal        @db.Decimal(10, 2)
  categoriaId Int
  estado      EstadoProducto @default(ACTIVO)
  categoria   Categoria      @relation(fields: [categoriaId], references: [id])
  variantes   Variante[]
  imagenes    Imagen[]
}

// DDS §4.2 — fragmento textual, sin modificar. RF-016 exige sku por
// variante; RN-001 (ver producto.repository.js) exige stock > 0 para que un
// producto se considere disponible.
model Variante {
  id         Int      @id @default(autoincrement())
  productoId Int
  sku        String   @unique
  talla      String
  color      String?
  stock      Int      @default(0)
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([productoId, talla, color])
}

model Imagen {
  id         Int      @id @default(autoincrement())
  productoId Int
  url        String
  orden      Int      @default(0)
  producto   Producto @relation(fields: [productoId], references: [id])
}
